datasource db {
  provider = "mysql"
}

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

enum Role {
  OWNER
  MANAGER
  GERANT
  CASHIER
}

model Company {
  id             Int      @id @default(autoincrement())
  name           String
  commercialName String?
  address        String?
  phone          String?
  email          String?
  website        String?
  taxId          String?
  logo           String?
  currency       String   @default("FCFA")
  receiptFormat  String   @default("80mm")
  receiptHeader  String?
  receiptFooter  String?
  openTime       String?
  closeTime      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users             User[]
  stores            Store[]
  categories        Category[]
  products           Product[]
  articles           Article[]
  articleMovements   ArticleMovement[]
  cashRegisters      CashRegister[]
  sales              Sale[]
  auditLogs          AuditLog[]
  inventorySessions  InventorySession[]
  expenses           Expense[]
  licenses           License[]
  rolePermissions    RolePermission[]
}

// A physical branch/location under a Company. Stores are fully independent
// of each other (own catalog, categories, stock, sales, registers) — the
// Company is just the umbrella that owns them all and that Direction
// (the OWNER role) sees across. Every existing single-store install gets a
// single "Magasin principal" Store row via migration backfill, so nothing
// changes for them until they actually add a second store.
model Store {
  id        Int      @id @default(autoincrement())
  companyId Int
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  address   String?
  phone     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  users             User[]
  categories        Category[]
  products          Product[]
  articles          Article[]
  articleMovements  ArticleMovement[]
  cashRegisters     CashRegister[]
  sales             Sale[]
  expenses          Expense[]
  inventorySessions InventorySession[]

  @@index([companyId])
}

model User {
  id        Int      @id @default(autoincrement())
  companyId Int
  company   Company  @relation(fields: [companyId], references: [id])
  // Null only for OWNER (Direction) — every other role must belong to
  // exactly one store, enforced at user creation (server/api/users).
  storeId   Int?
  store     Store?   @relation(fields: [storeId], references: [id])
  name      String
  email     String   @unique
  username  String   @unique
  password  String
  pinCode   String?
  // Per-account UI language ("fr" or "ar") — see server/api/auth/locale.post.ts
  // and Header2.vue's language switcher. Not company-wide: two staff on the
  // same account can each pick their own.
  locale    String   @default("fr")
  role      Role     @default(CASHIER)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  cashSessions       CashSession[]
  sales              Sale[]
  stockMovements     StockMovement[]
  articleMovements   ArticleMovement[]
  inventorySessions  InventorySession[]
  auditLogs          AuditLog[]
  passwordResetTokens PasswordResetToken[]
  expenses           Expense[]
  generatedLicenses  License[]
  pushSubscriptions  PushSubscription[]

  @@index([companyId])
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  token     String   @unique @db.VarChar(512)
  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id])
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Category {
  id        Int        @id @default(autoincrement())
  companyId Int
  company   Company    @relation(fields: [companyId], references: [id])
  storeId   Int
  store     Store      @relation(fields: [storeId], references: [id])
  name      String
  parentId  Int?
  parent    Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryToCategory")
  createdAt DateTime   @default(now())

  products  Product[]

  @@index([companyId])
  @@index([storeId])
}

model Product {
  id             Int       @id @default(autoincrement())
  companyId      Int
  company        Company   @relation(fields: [companyId], references: [id])
  storeId        Int
  store          Store     @relation(fields: [storeId], references: [id])
  label          String
  categoryId     Int?
  category       Category? @relation(fields: [categoryId], references: [id])
  type           String    @default("Produit")
  stockable      Boolean   @default(true)
  quantity       Int       @default(0)
  alertThreshold Int       @default(5)
  purchasePrice  Decimal   @default(0) @db.Decimal(12, 2)
  salePrice      Decimal   @default(0) @db.Decimal(12, 2)
  barcode        String?
  reference      String?
  image          String?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  stockMovements StockMovement[]
  saleLines      SaleLine[]
  inventoryLines InventoryLine[]

  @@index([companyId])
  @@index([storeId])
  @@index([barcode])
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
}

model StockMovement {
  id          Int               @id @default(autoincrement())
  productId   Int
  product     Product           @relation(fields: [productId], references: [id])
  userId      Int
  user        User              @relation(fields: [userId], references: [id])
  type        StockMovementType
  quantity    Int
  reason      String
  observation String?
  createdAt   DateTime          @default(now())

  @@index([productId])
}

// Raw ingredients/supplies (flour, milk, packaging...) consumed to make the
// Products that actually get sold — a separate inventory from Product's,
// since a bakery/restaurant's ingredient stock and its sellable menu are
// two different lists with different units (kg/L/pièce, not "units sold").
model Article {
  id          Int      @id @default(autoincrement())
  companyId   Int
  company     Company  @relation(fields: [companyId], references: [id])
  storeId     Int
  store       Store    @relation(fields: [storeId], references: [id])
  designation String
  // Decimal, not Int, because ingredient quantities are routinely
  // fractional (1.5 kg, 0.25 L) unlike Product.quantity's whole units sold.
  quantity    Decimal  @default(0) @db.Decimal(12, 3)
  // Free text, not an enum: the UI offers a preset list of common
  // restaurant units (kg, L, pièce...) but must also accept a custom one
  // the user types in — an enum can't do that without a migration per unit.
  unit        String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  movementLines ArticleMovementLine[]

  @@index([companyId])
  @@index([storeId])
}

// One document per submission (like Sale/SaleLine) — a delivery bringing in
// several ingredients, or a prep session consuming several, entered together
// in one Entrée/Sortie. Split from a single flat table so a movement can be
// referenced, viewed as one document (a "proforma"-style view listing every
// line), and edited as a whole — a bare per-line ledger row can't support
// any of that.
model ArticleMovement {
  id          Int               @id @default(autoincrement())
  companyId   Int
  company     Company           @relation(fields: [companyId], references: [id])
  storeId     Int
  store       Store             @relation(fields: [storeId], references: [id])
  number      Int
  type        StockMovementType
  userId      Int
  user        User              @relation(fields: [userId], references: [id])
  observation String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  lines ArticleMovementLine[]

  @@index([companyId])
  @@index([storeId])
}

model ArticleMovementLine {
  id                Int             @id @default(autoincrement())
  articleMovementId Int
  articleMovement   ArticleMovement @relation(fields: [articleMovementId], references: [id])
  articleId         Int
  article           Article         @relation(fields: [articleId], references: [id])
  quantity          Decimal         @db.Decimal(12, 3)

  @@index([articleMovementId])
  @@index([articleId])
}

enum InventoryStatus {
  DRAFT
  VALIDATED
}

model InventorySession {
  id          Int              @id @default(autoincrement())
  companyId   Int
  company     Company          @relation(fields: [companyId], references: [id])
  storeId     Int
  store       Store            @relation(fields: [storeId], references: [id])
  userId      Int
  user        User             @relation(fields: [userId], references: [id])
  status      InventoryStatus  @default(DRAFT)
  createdAt   DateTime         @default(now())
  validatedAt DateTime?

  lines InventoryLine[]

  @@index([companyId])
  @@index([storeId])
}

model InventoryLine {
  id                 Int              @id @default(autoincrement())
  inventorySessionId Int
  inventorySession   InventorySession @relation(fields: [inventorySessionId], references: [id])
  productId          Int
  product            Product          @relation(fields: [productId], references: [id])
  theoretical        Int
  real               Int
  gap                Int

  @@index([inventorySessionId])
}

model CashRegister {
  id        Int     @id @default(autoincrement())
  companyId Int
  company   Company @relation(fields: [companyId], references: [id])
  storeId   Int
  store     Store   @relation(fields: [storeId], references: [id])
  name      String
  active    Boolean @default(true)

  sessions CashSession[]

  @@index([companyId])
  @@index([storeId])
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

model CashSession {
  id                Int                @id @default(autoincrement())
  cashRegisterId    Int
  cashRegister      CashRegister       @relation(fields: [cashRegisterId], references: [id])
  userId            Int
  user              User               @relation(fields: [userId], references: [id])
  status            CashSessionStatus  @default(OPEN)
  startingFloat     Decimal            @db.Decimal(12, 2)
  openedAt          DateTime           @default(now())
  closedAt          DateTime?
  countedAmount     Decimal?           @db.Decimal(12, 2)
  theoreticalAmount Decimal?           @db.Decimal(12, 2)
  gap               Decimal?           @db.Decimal(12, 2)
  cashIn            Decimal            @default(0) @db.Decimal(12, 2)
  cashOut           Decimal            @default(0) @db.Decimal(12, 2)

  sales Sale[]

  @@index([cashRegisterId])
}

enum SaleStatus {
  COMPLETED
  CANCELLED
}

model Sale {
  id            Int         @id @default(autoincrement())
  companyId     Int
  company       Company     @relation(fields: [companyId], references: [id])
  storeId       Int
  store         Store       @relation(fields: [storeId], references: [id])
  number        Int
  cashSessionId Int
  cashSession   CashSession @relation(fields: [cashSessionId], references: [id])
  userId        Int
  user          User        @relation(fields: [userId], references: [id])
  total         Decimal     @db.Decimal(12, 2)
  status        SaleStatus  @default(COMPLETED)
  createdAt     DateTime    @default(now())

  lines    SaleLine[]
  payments Payment[]

  @@index([companyId])
  @@index([storeId])
  @@index([cashSessionId])
}

model SaleLine {
  id        Int     @id @default(autoincrement())
  saleId    Int
  sale      Sale    @relation(fields: [saleId], references: [id])
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  label     String
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  discount  Decimal @default(0) @db.Decimal(12, 2)
  total     Decimal @db.Decimal(12, 2)

  @@index([saleId])
}

enum PaymentMethod {
  CASH
  CARD
  WAVE
  ORANGE_MONEY
}

model Payment {
  id     Int           @id @default(autoincrement())
  saleId Int
  sale   Sale          @relation(fields: [saleId], references: [id])
  method PaymentMethod
  amount Decimal       @db.Decimal(12, 2)

  @@index([saleId])
}

model Expense {
  id          Int      @id @default(autoincrement())
  companyId   Int
  company     Company  @relation(fields: [companyId], references: [id])
  storeId     Int
  store       Store    @relation(fields: [storeId], references: [id])
  date        DateTime
  amount      Decimal  @db.Decimal(12, 2)
  description String
  category    String
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())

  @@index([companyId])
  @@index([storeId])
}

model License {
  id                Int       @id @default(autoincrement())
  companyId         Int
  company           Company   @relation(fields: [companyId], references: [id])
  key               String    @unique
  generatedByUserId Int
  generatedByUser   User      @relation(fields: [generatedByUserId], references: [id])
  activatedAt       DateTime?
  expiresAt         DateTime?
  createdAt         DateTime  @default(now())
  // Dedupes the "licence bientôt expirée" push notification to once per
  // license (see server/api/license/status.get.ts) instead of re-sending it
  // on every status check while the license sits in the expiry window.
  expiryNotifiedAt  DateTime?

  @@index([companyId])
}

// Presence of a row = that role has access to that module for the company.
// OWNER never needs a row here — it always has full access regardless of
// this table (see server/utils/permissions.ts).
model RolePermission {
  id        Int      @id @default(autoincrement())
  companyId Int
  company   Company  @relation(fields: [companyId], references: [id])
  role      Role
  module    String
  createdAt DateTime @default(now())

  @@unique([companyId, role, module])
  @@index([companyId])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  companyId Int
  company   Company  @relation(fields: [companyId], references: [id])
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  Int?
  oldValue  Json?
  newValue  Json?
  createdAt DateTime @default(now())

  @@index([companyId])
}
