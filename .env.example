# MySQL connection string
DATABASE_URL="mysql://root:@localhost:3306/caissebi"

# Random string (32+ chars) used to encrypt session cookies (nuxt-auth-utils)
NUXT_SESSION_PASSWORD="change-this-to-a-long-random-secret-string"

# Public origin of the app, used to build absolute links in emails (e.g. password reset).
# Falls back to the incoming request's origin at runtime if unset.
NUXT_PUBLIC_SITE_URL="http://localhost:3000"

# SMTP settings used to send transactional emails (password reset, etc).
# Set the real values as environment variables in your hosting panel (cPanel) — never commit real credentials.
SMTP_HOST="mail.example.com"
SMTP_PORT="587"
# "true" for port 465 (implicit TLS), "false" for 587/STARTTLS
SMTP_SECURE="false"
SMTP_USER="no-reply@example.com"
SMTP_PASS="change-this-smtp-password"
SMTP_FROM="CaisseBi <no-reply@example.com>"

# Firebase Cloud Messaging (push notifications). Get these from the Firebase
# console for the "caissebi" project > Project settings.
# Service account JSON (Project settings > Service accounts > Generate new
# private key), base64-encoded as a single line: base64 -w0 service-account.json
FIREBASE_SERVICE_ACCOUNT_BASE64="change-this-to-your-base64-encoded-service-account-json"
# Cloud Messaging > Web configuration > Web Push certificates
NUXT_PUBLIC_FIREBASE_VAPID_KEY="change-this-to-your-vapid-public-key"
